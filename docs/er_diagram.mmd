    AIRLINES {
      bigint airline_id PK
      varchar iata_code UK
      varchar airline_name
    }
    AIRPORTS {
      bigint airport_id PK
      varchar iata_code UK
      varchar airport_name
      varchar city
    }
    AIRCRAFT {
      bigint aircraft_id PK
      bigint airline_id FK
      varchar registration_no UK
      varchar model
      int economy_seats
      int business_seats
    }
    FLIGHTS {
      bigint flight_id PK
      varchar flight_number UK
      bigint airline_id FK
      bigint origin_airport_id FK
      bigint destination_airport_id FK
      time departure_time
      time arrival_time
      decimal distance_km
    }
    FARE_RULES {
      bigint flight_id PK, FK
      enum cabin_class PK
      decimal base_fare
    }
    FLIGHT_SCHEDULES {
      bigint flight_schedule_id PK
      bigint flight_id FK
      bigint aircraft_id FK
      date flight_date
      enum schedule_status
      int overbook_limit
    }
    FLIGHT_SEATS {
      bigint flight_seat_id PK
      bigint flight_schedule_id FK
      varchar seat_no
      enum cabin_class
    }
    AIR_BOOKINGS {
      bigint air_booking_id PK
      bigint passenger_id FK
      bigint flight_schedule_id FK
      enum cabin_class
      enum status
      decimal fare
      decimal base_fare
      decimal loyalty_discount_percent
      decimal loyalty_discount_amount
      enum loyalty_tier_at_booking
      decimal refund_amount
    }
    AIR_SEAT_ALLOCATIONS {
      bigint allocation_id PK
      bigint flight_schedule_id FK
      bigint flight_seat_id FK
      bigint air_booking_id FK
    }
    AIR_STANDBY_ENTRIES {
      bigint standby_id PK
      bigint air_booking_id FK
      tinyint priority_score
      enum status
    }
    AIR_CANCELLATIONS {
      bigint cancellation_id PK
      bigint air_booking_id FK
      bigint released_flight_seat_id FK
      decimal refund_amount
    }
    AIR_BOOKING_HISTORY {
      bigint history_id PK
      bigint air_booking_id FK
      enum old_status
      enum new_status
      enum event_type
    }
    BAGGAGE {
      bigint air_booking_id PK, FK
      tinyint bag_no PK
      decimal weight_kg
      decimal excess_fee
    }
    LOYALTY_TXN {
      bigint loyalty_txn_id PK
      bigint passenger_id FK
      bigint booking_id FK
      bigint air_booking_id FK
      int points
    }
